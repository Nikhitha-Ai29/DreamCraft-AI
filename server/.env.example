# MySQL database
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=dreamcraft_ai
MYSQL_USER=dreamcraft
MYSQL_PASSWORD=your_mysql_password

# NVIDIA chatbot
NVIDIA_API_KEY=your_actual_nvidia_api_key
NVIDIA_MODEL=google/diffusiongemma-26b-a4b-it
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_IMAGE_GENERATION_ENABLED=false

# Local image generation (ComfyUI; no paid image API)
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_CHECKPOINT=v1-5-pruned-emaonly.safetensors
